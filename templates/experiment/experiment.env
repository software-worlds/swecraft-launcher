# Host settings for this experiment, read by swecraft-launch.
# Never put credentials here: model keys stay in the shell's environment and reach
# the agents through coordinator.yaml's agent_env (env: sources).

# The forge: an address wake containers reach it by (the Docker bridge on Linux),
# its port, and its Compose project (the same name goes in checkpoint.yaml).
SWECRAFT_FORGE_HOST=172.17.0.1
SWECRAFT_FORGE_PORT=3400
COMPOSE_PROJECT_NAME=FILL-compose-project

# CI on the forge: runner slots and per-job limits. Size capacity x memory well
# under the host's RAM; an unbounded test job can take the whole host.
SWECRAFT_FORGE_RUNNER_CAPACITY=4
SWECRAFT_FORGE_JOB_MEMORY=8g
SWECRAFT_FORGE_JOB_CPUS=4

# The capped package index: PyPI as it stood on the world's start date. CI reads
# these; agent images get the same index from images/index-cap. `up` starts
# swecraft-index-cap on this port when nothing answers. Empty = today's PyPI.
SWECRAFT_FORGE_INDEX_URL=http://172.17.0.1:5280/FILL-yyyy-mm-dd/simple/
SWECRAFT_FORGE_EXCLUDE_NEWER=FILL-yyyy-mm-ddT00:00:00Z

# Wake containers (Harbor's default is 4 CPUs / 16 GiB).
SWECRAFT_SANDBOX_CPUS=4
SWECRAFT_SANDBOX_MEMORY_MB=16384

# Measurement: the evaluation in evaluation.yaml to sweep, and how often.
EVALUATION=society-sim
MEASURE_INTERVAL_SECONDS=7200

# Stop rule: completed wakes (of STOP_AGENTS, comma-separated; default every
# agent) or total spend in dollars, whichever comes first. `run` then drains
# the coordinator and finishes the experiment.
STOP_WAKES=FILL
STOP_DOLLARS=FILL
